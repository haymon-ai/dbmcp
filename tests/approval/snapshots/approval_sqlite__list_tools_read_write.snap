---
source: tests/approval/sqlite.rs
expression: tools
---
[
  {
    "name": "explain",
    "title": "Explain",
    "description": "Return the execution plan for a SQL query to diagnose performance. Use this tool instead of running EXPLAIN directly through `read` — it provides structured output via EXPLAIN QUERY PLAN.\n\n<usecase>\nUse when:\n- A query runs slowly and you need to understand why\n- Understanding how SQLite will scan tables and use indexes\n- Deciding whether to add an index\n</usecase>\n\n<when_not_to_use>\n- Running actual queries → use `read`, or `write` for data changes (not available in read-only mode)\n- Checking table structure → use objects with `detail: \"full\"`\n</when_not_to_use>\n\n<examples>\n✓ \"Why is my SELECT on orders slow?\" → explain(query=\"SELECT ...\")\n✓ \"How will SQLite execute this join?\" → `explain`\n✗ \"Run this SELECT\" → use `read`\n</examples>\n\n<what_it_returns>\nA JSON array of EXPLAIN QUERY PLAN rows showing how SQLite will scan tables, use indexes, and order operations.\n\nLong string values are cut and end in `…[truncated, N chars total]`, and rows past the response size cap are dropped and counted in `rowsOmitted`; when either happens the response carries `truncated: true` and a `hint`.\n</what_it_returns>",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "description": "The SQL query to explain.",
          "type": "string"
        }
      },
      "required": [
        "query"
      ]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "rows": {
          "description": "Result rows, each a JSON object keyed by a column name.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "truncated": {
          "description": "Present and `true` when a character cap cut a value or dropped rows.",
          "type": "boolean"
        },
        "hint": {
          "description": "How to fetch less data; present only when `truncated` is `true`.",
          "type": [
            "string",
            "null"
          ]
        },
        "rowsOmitted": {
          "description": "Rows the response cap dropped that no cursor can fetch again.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "rows"
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "objects",
    "title": "Objects",
    "description": "List database objects by kind: names, or full metadata keyed by name.\n\n<usecase>\nUse before writing SQL to discover object names and shapes. Prefer this over querying the catalog through `read`.\n</usecase>\n\n<examples>\n✓ \"What tables are there?\" → objects()\n✓ \"What columns does orders have?\" → objects(search=\"orders\", detail=\"full\")\n✓ \"Which triggers exist?\" → objects(kind=\"trigger\")\n</examples>\n\n<what_it_returns>\n`detail: \"names\"`: `{\"objects\": [...]}`, a sorted array of name strings.\n`detail: \"full\"`: `{\"objects\": {name: metadata}}`; the name is the key and is not repeated. Metadata per kind:\n- `table`: `schema`, `kind`, `owner`, `comment`, `columns`, `constraints`, `indexes`, `triggers`.\n- `view`: names only; `search` and `detail` are rejected.\n- `trigger`: `schema`, `table`, `definition` (the stored `CREATE TRIGGER` text).\n</what_it_returns>\n\n<pagination>\nKeep `kind`, `search`, and `detail` the same across pages.\n</pagination>\n",
    "inputSchema": {
      "type": "object",
      "properties": {
        "kind": {
          "description": "Kind of object to list. Defaults to `table`.",
          "oneOf": [
            {
              "description": "Tables in the database.",
              "type": "string",
              "const": "table"
            },
            {
              "description": "Views in the database; names only.",
              "type": "string",
              "const": "view"
            },
            {
              "description": "Triggers in the database.",
              "type": "string",
              "const": "trigger"
            }
          ]
        },
        "search": {
          "description": "Optional case-insensitive filter on object names. The input is used within a `LIKE`\nclause: `%` matches any sequence of characters and `_` matches any single character.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "detail": {
          "description": "How much metadata to return per object. Defaults to `names`.",
          "oneOf": [
            {
              "description": "A sorted array of bare object names.",
              "type": "string",
              "const": "names"
            },
            {
              "description": "An object keyed by name, each value carrying the object's full metadata.",
              "type": "string",
              "const": "full"
            }
          ]
        },
        "cursor": {
          "description": "Opaque cursor from a prior response's `nextCursor`; omit for the first page.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      }
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "objects": {
          "description": "Page of matching objects. Shape depends on the request's `detail`.",
          "anyOf": [
            {
              "description": "Brief mode: sorted array of bare object-name strings.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "description": "Detailed mode: name-keyed map; insertion order matches the SQL `ORDER BY` sort.",
              "type": "object",
              "additionalProperties": true
            }
          ]
        },
        "nextCursor": {
          "description": "Opaque cursor pointing to the next page. Absent when this is the final page.",
          "type": "string"
        }
      },
      "required": [
        "objects"
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "read",
    "title": "Read",
    "description": "Execute a read-only SQL query. Allowed statements: SELECT, EXPLAIN.\n\n<usecase>\nUse when:\n- Querying data from tables (SELECT with WHERE, JOIN, GROUP BY, etc.)\n- Aggregations: COUNT, SUM, AVG, GROUP BY, HAVING\n- Checking data existence or counts\n</usecase>\n\n<when_not_to_use>\n- Data changes (INSERT, UPDATE, DELETE) → use `write` (not available in read-only mode)\n- Query performance analysis → use `explain`\n- Discovering tables or columns → use objects (pass `detail: \"full\"` for columns)\n</when_not_to_use>\n\n<examples>\n✓ \"SELECT * FROM users WHERE status = 'active'\"\n✓ \"SELECT COUNT(*) FROM orders GROUP BY region\"\n✗ \"INSERT INTO users ...\" → use `write` (not available in read-only mode)\n✗ \"EXPLAIN SELECT ...\" → use `explain` for structured analysis\n</examples>\n\n<what_it_returns>\nA JSON array of row objects, each keyed by column name.\n\nLong string values are cut and end in `…[truncated, N chars total]`; read the rest with `SUBSTRING`/`SUBSTR`. Rows past the response size cap are dropped: a `SELECT` page ends early and `nextCursor` resumes at the first row left out, while other statements report the count in `rowsOmitted`. When either happens the response carries `truncated: true` and a `hint`.\n</what_it_returns>\n\n<pagination>\n`SELECT` results are paginated. Pass the prior response's `nextCursor` as `cursor` to fetch the next page. Order by a unique key so pages neither skip nor repeat rows. Pages stay within the statement's own `LIMIT` and `OFFSET`. Write a row limit as a literal `LIMIT n`: other forms (`FETCH FIRST`, expressions) make every page read the whole result. `EXPLAIN` returns a single page and ignores `cursor`.\n</pagination>\n\n<timeout>\nEach call stops at the configured query timeout. On a timeout, check the plan with `explain` before retrying: filter on indexed columns, or limit inner result sets before joining or aggregating. For a query known to be slow, pass `timeout` (seconds, at least 1) to allow more time. This only helps if the server allows a higher maximum, which is often the same as the default; a value above it is rejected with an error naming the maximum.\n</timeout>",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "description": "The SQL query to execute.",
          "type": "string"
        },
        "cursor": {
          "description": "Opaque pagination cursor. Omit (or pass `null`) for the first page.\nOn subsequent calls, pass the `nextCursor` returned by the previous\nresponse verbatim. Cursors are opaque — do not parse, modify, or persist.\nIgnored for `EXPLAIN` statements.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "timeout": {
          "description": "Seconds this call may run, from 1 up to the server maximum. Defaults to the configured query timeout.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 1,
          "default": null
        }
      },
      "required": [
        "query"
      ]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "rows": {
          "description": "Result rows, each a JSON object keyed by a column name.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "nextCursor": {
          "description": "Opaque cursor pointing to the next page. Absent when this is the final\npage, when the result fits in one page, or when the statement is a\nnon-`SELECT` kind that does not paginate (e.g. `SHOW`, `EXPLAIN`).",
          "type": "string"
        },
        "truncated": {
          "description": "Present and `true` when a character cap cut a value or dropped rows.",
          "type": "boolean"
        },
        "hint": {
          "description": "How to fetch less data; present only when `truncated` is `true`.",
          "type": [
            "string",
            "null"
          ]
        },
        "rowsOmitted": {
          "description": "Rows the response cap dropped that no cursor can fetch again.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "rows"
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "write",
    "title": "Write",
    "description": "Execute a write SQL query (INSERT, UPDATE, DELETE, CREATE, ALTER, DROP).\n\n<usecase>\nUse when:\n- Inserting, updating, or deleting rows\n- Creating or altering tables, indexes, views, or other schema objects\n- Any data modification operation\n</usecase>\n\n<when_not_to_use>\n- Read-only queries (SELECT) → use `read`\n- Query performance analysis → use `explain`\n</when_not_to_use>\n\n<examples>\n✓ \"INSERT INTO users (name, email) VALUES ('Alice', 'alice@example.com')\"\n✓ \"UPDATE orders SET status = 'shipped' WHERE id = 42\"\n✓ \"CREATE TABLE logs (id INTEGER PRIMARY KEY, message TEXT)\"\n✗ \"SELECT * FROM users\" → use `read`\n</examples>\n\n<what_it_returns>\nAn object with:\n- `rows`: rows returned by a `RETURNING` clause, each keyed by column name; empty otherwise.\n- `rowsAffected`: rows inserted, updated, or deleted. `0` for schema changes.\n- `lastInsertId`: the rowid of the last row inserted by an `INSERT`/`REPLACE`. Absent after other statements; use `RETURNING` for `WITHOUT ROWID` tables and upserts.\n\nNo follow-up `SELECT` is needed to confirm a write.\n\nLong string values are cut and end in `…[truncated, N chars total]`, and rows past the response size cap are dropped and counted in `rowsOmitted`; when either happens the response carries `truncated: true` and a `hint`.\n</what_it_returns>",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "description": "The SQL query to execute.",
          "type": "string"
        }
      },
      "required": [
        "query"
      ]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "rows": {
          "description": "Rows returned by the statement (e.g. `RETURNING`), each a JSON object keyed by a column name.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "rowsAffected": {
          "description": "Number of rows the statement inserted, updated, or deleted; `0` for schema changes.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "lastInsertId": {
          "description": "Id generated by an `INSERT`; absent when none was generated.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "truncated": {
          "description": "Present and `true` when a character cap cut a value or dropped rows.",
          "type": "boolean"
        },
        "hint": {
          "description": "How to fetch less data; present only when `truncated` is `true`.",
          "type": [
            "string",
            "null"
          ]
        },
        "rowsOmitted": {
          "description": "Rows the response cap dropped that no cursor can fetch again.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "rows",
        "rowsAffected"
      ]
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": true
    }
  }
]
